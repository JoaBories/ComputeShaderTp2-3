#version 430 core
layout(local_size_x = 256) in;
struct Particle { vec4 posType; vec4 vel; };
layout(std430, binding = 0) readonly buffer Current { Particle current[]; };

layout(std430, binding = 6) buffer Maximums { ivec3 maxi[]; };

uniform uint N;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= N) return;
    
    vec3 pos = current[id].posType.xyz;
    
    maxi[0].x = atomicMin(maxi[0].x, int(floor(pos.x)));
    maxi[0].y = atomicMin(maxi[0].y, int(floor(pos.y)));
    maxi[0].z = atomicMin(maxi[0].z, int(floor(pos.z)));
    maxi[1].x = atomicMax(maxi[1].x, int(ceil(pos.x)));
    maxi[1].y = atomicMax(maxi[1].y, int(ceil(pos.y)));
    maxi[1].z = atomicMax(maxi[1].z, int(ceil(pos.z)));
}
