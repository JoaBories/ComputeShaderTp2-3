#version 430 core
layout(local_size_x = 256) in;
struct Particle { vec4 posType; vec4 vel; };
layout(std430, binding = 0) readonly buffer Current { Particle current[]; };
layout(std430, binding = 4) buffer Heads { int cellHead[]; };
layout(std430, binding = 5) buffer Links { int nextParticle[]; };

layout(std430, binding = 6) readonly buffer Maximums { ivec3 maxi[]; };

uniform uint N;
uniform int gridSize;

ivec3 getCellPos(vec3 pPos, vec3 origin, vec3 cellSize) { return ivec3(floor(pPos - origin / cellSize)); }
uint getCellId(ivec3 c) { return uint(c.x + gridSize*(c.y + gridSize*c.z)); }

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= N) return;
    
    vec3 origin = vec3(maxi[1]+maxi[0])/2;
    vec3 cellSize = vec3(abs(maxi[0]+maxi[1])/gridSize);
    
    vec3 pos = current[id].posType.xyz;
    uint cellIndex = getCellId(getCellPos(pos, origin, cellSize));
    if (cellIndex < gridSize*gridSize*gridSize)
    {
        int previousId = atomicExchange(cellHead[cellIndex], int(id));
        nextParticle[id] = previousId;
    }
}
