#version 430 core
layout(local_size_x = 256) in;
struct Particle { vec4 posType; vec4 vel; };

layout(std430, binding = 0) readonly buffer Current { Particle current[]; };
layout(std430, binding = 1) writeonly buffer Next { Particle next[]; };

layout(std430, binding = 4) buffer Heads { int cellHead[]; };       // une entree par cellule 
layout(std430, binding = 5) buffer Chained { int nextParticle[]; }; // une entree par boid

uniform uint N;
uniform float boxSize;
uniform float R;
uniform int nC;
uniform int gridSize;

uniform float dt;

ivec3 getCellPos(vec3 pPos) { return ivec3(floor(pPos / R)); }
uint getCellId(ivec3 c) { return uint(c.x + gridSize*(c.y + gridSize*c.z)); }

void reflectInBox(inout vec3 position, inout vec3 velocity) {
  vec3 hitMin = vec3(lessThan(position, vec3(0.0)));
  vec3 hitMax = vec3(greaterThan(position, vec3(boxSize)));
  position = mix(position, -position, hitMin);
  position = mix(position, 2.0 * boxSize - position, hitMax);
  velocity *= 1.0 - 2.0 * max(hitMin, hitMax);
}

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= N) return;

  vec3 pos = current[id].posType.xyz;
  vec3 vel = current[id].vel.xyz;
  float itype = current[id].posType.w;
  ivec3 c = getCellPos(pos);

  vec3 force = vec3(0.0f);
  
  int xMin = max(0,   c.x - 1);
  int xMax = min(gridSize-1, c.x + 1);
  int yMin = max(0,   c.y - 1);
  int yMax = min(gridSize-1, c.y + 1);
  int zMin = max(0,   c.z - 1);
  int zMax = min(gridSize-1, c.z + 1);

  for (int x = xMin; x <= xMax; x++) {
    for (int y = yMin; y <= yMax; y++) {
      for (int z = zMin; z <= zMax; z++) {
        uint cell = getCellId(ivec3(x,y,z));

        for (int j = cellHead[cell]; j != -1; j = nextParticle[j]) {
          if (j == id) continue;

          vec3 jpos = current[j].posType.xyz;
          float jtype = current[j].posType.w;

          vec3 ij = jpos - pos;
          float dSquared = dot(ij, ij);

          if (dSquared > R*R) continue;

          force += 0.02f * jtype * itype * ij / pow(dSquared + 0.25f, 1.5f);
          
        }
      }
    }
  }
  
  vec3 newVel = clamp(vel + force * dt, -8.f, 8.f);
  
  vec3 newPos = pos + newVel * dt;
  
  reflectInBox(newPos, newVel);

  next[id].posType = vec4(newPos, itype);
  next[id].vel = vec4(newVel, 0.0f);
}
