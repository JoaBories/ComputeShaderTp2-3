#version 430 core
layout(local_size_x = 256) in;

struct AABB {
    vec4 min; // xyz : corner min, w : unused useful for std430
    vec4 max; // xyz : corner max, w : unused useful for std430
};

layout(std430, binding = 2) buffer Cluster {
    AABB aabb[];
};

uniform uvec3 N;
uniform vec2 screenSize;
uniform vec2 screenPanes;

ivec3 idtopos(int id)
{
    uint x = id % N.x;
    uint y = (id / N.x) % N.y;
    uint z = id / (N.x * N.y);
    return ivec3(x, y, z);
}

int postoid(ivec3 pos)
{
    return int(pos.x + pos.y * N.x + pos.z * N.x * N.y);
}

void main() {
    int id = int(gl_GlobalInvocationID.x);
    if(id > (N.x * N.y * N.z)) return;
    
    ivec3 pos = idtopos(id);
}